  "the-last-of-us": {
    "summary": {
      "recommended": 187210,
      "notRecommended": 16211,
      "total": 203421
    },
    "reviews": [
      {
        "id": "the-last-of-us-1",
        "recommended": true,
        "postedAt": "2025-06-10",
        "text": "The Last of Us delivers one of the most emotionally gripping stories I've ever experienced. The relationship between Joel and Ellie is beautifully written. Combat is intense, stealth feels rewarding, and the environments are hauntingly gorgeous. Definitely a must-play.",
        "author": {
          "name": "Stefan Arnold",
          "avatar": "/images/stefan.webp"
        },
        "helpful": 34
      },
      {
        "id": "the-last-of-us-2",
        "recommended": false,
        "postedAt": "2025-04-14",
        "text": "I really wanted to enjoy this game, but the constant crashes and lack of optimization ruined the experience. The story had potential, but the gameplay felt repetitive and clunky. Hoping future patches improve things, but for now, I can't recommend it.",
        "author": {
          "name": "Liam V.",
          "avatar": "/images/liam-v.webp"
        },
        "helpful": 22
      },
      {
        "id": "the-last-of-us-3",
        "recommended": true,
        "postedAt": "2025-02-14",
        "text": "The Last of Us offers one of the most emotionally gripping stories I've ever experienced in a game. Joel and Ellie's journey is intense, heartbreaking, and beautifully told, with strong voice acting and cinematic quality that pulls you in. Gameplay-wise, it's a perfect mix of stealth, action, and survival. A few slower sections here and there, but the payoff at the end is absolutely worth it.",
        "author": {
          "name": "Darren Cole",
          "avatar": "/images/darren-cole.webp"
        },
        "helpful": 24
      }
    ]
  },
  "clair-obscur-expedition-33": {
    "summary": {
      "recommended": 122113,
      "notRecommended": 6427,
      "total": 128540
    },
    "reviews": [
      {
        "id": "clair-obscur-expedition-33-1",
        "recommended": true,
        "postedAt": "2025-08-21",
        "text": "The combat is the best turn-based system I've played in years. Dodging and parrying keeps every fight tense, and the painted world is stunning from start to finish.",
        "author": {
          "name": "Maya Lopez"
        },
        "helpful": 58
      },
      {
        "id": "clair-obscur-expedition-33-2",
        "recommended": true,
        "postedAt": "2025-07-03",
        "text": "A story that actually made me emotional. The music, the cast and the final act are all unforgettable. Easy game of the year pick for me.",
        "author": {
          "name": "Kenji Sato"
        },
        "helpful": 41
      },
      {
        "id": "clair-obscur-expedition-33-3",
        "recommended": false,
        "postedAt": "2025-06-14",
        "text": "Great art, but the difficulty spikes are rough and some side areas feel empty. I wanted more guidance on how builds work before the later bosses.",
        "author": {
          "name": "Alex Chen"
        },
        "helpful": 12
      }
    ]
  },
  "peak": {
    "summary": {
      "recommended": 82188,
      "notRecommended": 9132,
      "total": 91320
    },
    "reviews": [
      {
        "id": "peak-1",
        "recommended": true,
        "postedAt": "2025-07-19",
        "text": "Climbing with friends is chaos in the best way. Someone always forgets food, someone always falls, and we still laughed the whole time.",
        "author": {
          "name": "Rina Putri"
        },
        "helpful": 33
      },
      {
        "id": "peak-2",
        "recommended": true,
        "postedAt": "2025-06-28",
        "text": "Simple idea, very well done. The stamina and weather system keeps you thinking, and every run feels a little different.",
        "author": {
          "name": "Daniel Kim"
        },
        "helpful": 21
      },
      {
        "id": "peak-3",
        "recommended": false,
        "postedAt": "2025-08-02",
        "text": "Fun with friends, but playing alone gets lonely and repetitive pretty fast. Needs more content to stay interesting.",
        "author": {
          "name": "Sofia Rossi"
        },
        "helpful": 9
      }
    ]
  },
  "wuthering-waves": {
